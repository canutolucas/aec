    "test:watch": "vitest"
  },
  "dependencies": {
    "@aec/domain": "workspace:*",
    "fast-xml-parser": "^5.11.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
