{
  "name": "@aec/statements",
  "version": "0.0.1",
  "private": true,
  "description": "Bank statement readers — OFX and CSV are universal; PDF needs Node and stays out of the mobile bundle",
  "type": "module",
  "main": "./src/universal/index.ts",
  "types": "./src/universal/index.ts",
  "exports": {
    ".": "./src/universal/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
