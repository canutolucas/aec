# Supabase — copie para .env.local e preencha.
# Rodando local com `supabase start`, os valores sao impressos no terminal.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada apenas por scripts administrativos (seeds). NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=
